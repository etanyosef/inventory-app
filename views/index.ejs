<%- include('./partials/header') %>

<% if (bikes.length > 0) { %>
    <table>
        <tr>
            <th>Brand</th>
            <th>Model</th>
            <th>Model Year</th>
            <th>Color</th>
            <th>Category</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
        <% bikes.forEach(bike => { %>
            <tr>
                <td><%= bike.brand %></td>
                <td><%= bike.model_name %></td>
                <td><%= bike.model_year %></td>
                <td><%= bike.color %></td>
                <td><%= bike.category %></td>
                <td><%= bike.status %></td>
                <td>&#9998;</td>
            </tr>
        <% }) %>
    </table>
<% } else { %>
    <div>
        <h2>You dont have a bike yet.</h2>
        <a href="">Add bike</a>
    </div>
<% } %>

<%- include('./partials/footer') %>

